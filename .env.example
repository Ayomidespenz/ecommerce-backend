PORT=5000
MONGODB_URI=mongodb://localhost:27017/ecommerce-backend
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRY=30d
JWT_SECRET=your_jwt_secret_here
BCRYPT_SALT_ROUNDS=12
NODE_ENV=development

# OTP / verification
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_MINUTES=1

# Email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@fortunemart.com
BREVO_SENDER_NAME=FortuneMart

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Storage (Cloudinary / S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Payments (Paystack)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
DEFAULT_SHIPPING_FEE=1500
SERVICE_FEE_PERCENT=0


# Socket.io / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000


# Seller wallet and payout settings
BANK_ACCOUNT_ENCRYPTION_KEY=replace_with_a_long_random_secret
WITHDRAWAL_FEE_FLAT=0
WITHDRAWAL_FEE_PERCENT=0
